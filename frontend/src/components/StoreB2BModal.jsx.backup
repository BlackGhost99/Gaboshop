import React, { useState, useEffect } from 'react';
import Modal from './Modal';
import B2BPricingModal from './B2BPricingModal';
import {
	getStoreB2BProfile,
	createStoreB2BProfile,
	updateStoreB2BProfile,
	activateStoreB2B,
	deactivateStoreB2B,
} from '../services/b2bService';

/**
 * Modal pour gérer le profil B2B d'un store depuis l'admin
 */
const StoreB2BModal = ({ isOpen, onClose, store, onSuccess }) => {
	const [loading, setLoading] = useState(false);
	const [profile, setProfile] = useState(null);
	const [formData, setFormData] = useState({
		minimum_order_amount: 0,
		visible_to_all: true,
		is_active: true,
	});
	const [error, setError] = useState(null);
	const [showPricingModal, setShowPricingModal] = useState(false);

	useEffect(() => {
		if (isOpen && store) {
			loadProfile();
		}
	}, [isOpen, store]);

	const loadProfile = async () => {
		if (!store) return;

		try {
			setLoading(true);
			setError(null);
			// #region agent log
			fetch('http://127.0.0.1:7242/ingest/fced817a-6879-4b38-979a-ae3f1398a171', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sessionId: 'debug-session', runId: 'prefix', hypothesisId: 'A', location: 'StoreB2BModal.jsx:loadProfile', message: 'loadProfile start', data: { storeId: store?.id }, timestamp: Date.now() }) }).catch(() => {});
			// #endregion
			const response = await getStoreB2BProfile(store.id);
			if (response && response.success) {
				setProfile(response.data);
				setFormData({
					minimum_order_amount: response.data.minimum_order_amount || 0,
					visible_to_all: response.data.visible_to_all !== false,
					is_active: response.data.is_active !== false,
				});
			} else {
				// Pas de profil B2B existant (404 ou autre erreur)
				setProfile(null);
				setFormData({
					minimum_order_amount: 0,
					visible_to_all: true,
					is_active: true,
				});
			}
		} catch (err) {
			// Erreur inattendue (pas un 404 géré)
			setError(err.response?.data?.error?.message || 'Erreur lors du chargement du profil');
			setProfile(null);
			// #region agent log
			fetch('http://127.0.0.1:7242/ingest/fced817a-6879-4b38-979a-ae3f1398a171', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ sessionId: 'debug-session', runId: 'prefix', hypothesisId: 'A', location: 'StoreB2BModal.jsx:loadProfile', message: 'loadProfile unexpected error', data: { storeId: store?.id, status: err?.response?.status }, timestamp: Date.now() }) }).catch(() => {});
			// #endregion
		} finally {
			setLoading(false);
		}
	};

	const handleChange = (e) => {
		const { name, value, type, checked } = e.target;
		setFormData((prev) => ({
			...prev,
			[name]: type === 'checkbox' ? checked : value,
		}));
	};

	const handleActivate = async () => {
		if (!store) return;

		try {
			setLoading(true);
			setError(null);
			const response = await activateStoreB2B(store.id, formData);
			if (response.success) {
				setProfile(response.data);
				onSuccess?.();
				onClose();
			} else {
				setError(response.error?.message || 'Erreur lors de l\'activation');
			}
		} catch (err) {
			setError(err.response?.data?.error?.message || 'Erreur lors de l\'activation');
		} finally {
			setLoading(false);
		}
	};

	const handleDeactivate = async () => {
		if (!store || !profile) return;

		try {
			setLoading(true);
			setError(null);
			const response = await deactivateStoreB2B(store.id);
			if (response.success) {
				setProfile(response.data);
				onSuccess?.();
			} else {
				setError(response.error?.message || 'Erreur lors de la désactivation');
			}
		} catch (err) {
			setError(err.response?.data?.error?.message || 'Erreur lors de la désactivation');
		} finally {
			setLoading(false);
		}
	};

	const handleSave = async (e) => {
		e.preventDefault();
		if (!store) return;

		try {
			setLoading(true);
			setError(null);

			let response;
			if (profile) {
				// Mettre à jour
				response = await updateStoreB2BProfile(store.id, formData);
			} else {
				// Créer
				response = await createStoreB2BProfile(store.id, formData);
			}

			if (response.success) {
				setProfile(response.data);
				onSuccess?.();
				onClose();
			} else {
				setError(response.error?.message || 'Erreur lors de l\'enregistrement');
			}
		} catch (err) {
			setError(err.response?.data?.error?.message || 'Erreur lors de l\'enregistrement');
		} finally {
			setLoading(false);
		}
	};

	if (!store) return null;

	const hasProfile = profile !== null;
	const isB2BActive = store.is_b2b && hasProfile && profile.is_active;

	return (
		<Modal
			isOpen={isOpen}
			onClose={onClose}
			title={`Gestion B2B - ${store.name}`}
			size="md"
		>
			{loading && !profile ? (
				<div className="text-center py-8">
					<div className="animate-spin rounded-full h-8 w-8 border-b-2 border-indigo-600 mx-auto"></div>
					<p className="mt-2 text-sm text-gray-500">Chargement...</p>
				</div>
			) : (
				<div className="space-y-4">
					{/* Statut actuel */}
					<div className="bg-gray-50 rounded-lg p-4">
						<div className="flex items-center justify-between mb-2">
							<span className="text-sm font-semibold text-gray-700">Statut B2B</span>
							<span
								className={`px-3 py-1 rounded-full text-xs font-semibold ${
									isB2BActive
										? 'bg-green-100 text-green-800'
										: 'bg-gray-100 text-gray-800'
								}`}
							>
								{isB2BActive ? 'Actif' : 'Inactif'}
							</span>
						</div>
						<div className="text-xs text-gray-600 space-y-1">
							<p>Store is_b2b: {store.is_b2b ? '✓ Oui' : '✗ Non'}</p>
							{hasProfile && (
								<>
									<p>Profil B2B: {profile.is_active ? '✓ Actif' : '✗ Inactif'}</p>
									{profile.minimum_order_amount > 0 && (
										<p>
											Montant minimum: {parseFloat(profile.minimum_order_amount).toLocaleString('fr-FR')} FCFA
										</p>
									)}
								</>
							)}
						</div>
					</div>

					{error && (
						<div className="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded text-sm">
							{error}
						</div>
					)}

					{/* Formulaire */}
					<form onSubmit={handleSave} className="space-y-4">
						<div>
							<label className="block text-sm font-semibold text-gray-700 mb-1">
								Montant minimum de commande (FCFA)
							</label>
							<input
								type="number"
								name="minimum_order_amount"
								value={formData.minimum_order_amount}
								onChange={handleChange}
								className="w-full border border-gray-300 rounded px-3 py-2 text-sm"
								min="0"
								step="0.01"
							/>
						</div>

						<div className="flex items-center gap-2">
							<input
								type="checkbox"
								name="visible_to_all"
								id="visible_to_all"
								checked={formData.visible_to_all}
								onChange={handleChange}
								className="rounded"
							/>
							<label htmlFor="visible_to_all" className="text-sm font-medium text-gray-700">
								Visible par tous les magasins B2C
							</label>
						</div>

						{hasProfile && (
							<div className="flex items-center gap-2">
								<input
									type="checkbox"
									name="is_active"
									id="is_active"
									checked={formData.is_active}
									onChange={handleChange}
									className="rounded"
								/>
								<label htmlFor="is_active" className="text-sm font-medium text-gray-700">
									Profil B2B actif
								</label>
							</div>
						)}

						{/* Bouton pour gérer les prix B2B */}
					{hasProfile && isB2BActive && (
						<div className="bg-indigo-50 rounded-lg p-4">
							<h4 className="font-semibold text-indigo-900 mb-2">Prix B2B des produits</h4>
							<p className="text-sm text-indigo-700 mb-3">
								Configurez les prix de gros pour chaque produit de ce magasin.
							</p>
							<button
								type="button"
								onClick={() => setShowPricingModal(true)}
								className="w-full px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors"
							>
								📦 Gérer les prix B2B
							</button>
						</div>
					)}

					{/* Actions */}
						<div className="flex gap-3 pt-4 border-t border-gray-200">
							{hasProfile && isB2BActive && (
								<button
									type="button"
									onClick={handleDeactivate}
									disabled={loading}
									className="flex-1 px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 transition-colors disabled:bg-gray-300 disabled:cursor-not-allowed"
								>
									Désactiver B2B
								</button>
							)}
							{(!hasProfile || !isB2BActive) && (
								<button
									type="button"
									onClick={handleActivate}
									disabled={loading}
									className="flex-1 px-4 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors disabled:bg-gray-300 disabled:cursor-not-allowed"
								>
									Activer B2B
								</button>
							)}
							<button
								type="submit"
								disabled={loading}
								className="flex-1 px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 transition-colors disabled:bg-gray-300 disabled:cursor-not-allowed"
							>
								{loading ? 'Enregistrement...' : 'Enregistrer'}
							</button>
							<button
								type="button"
								onClick={onClose}
								className="px-4 py-2 border border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 transition-colors"
							>
								Fermer
							</button>
						</div>
					</form>
				</div>
			)}

			{/* Modal de gestion des prix B2B */}
			<B2BPricingModal
				isOpen={showPricingModal}
				onClose={() => setShowPricingModal(false)}
				store={store}
				onSuccess={onSuccess}
			/>
		</Modal>
	);
};

export default StoreB2BModal;

