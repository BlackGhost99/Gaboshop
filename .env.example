# Local development
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web,testserver
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set these only when HTTPS is terminated by your production proxy.
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# Payments
SINGPAY_BASE_URL=
SINGPAY_CLIENT_ID=
SINGPAY_CLIENT_SECRET=
SINGPAY_WALLET_ID=
SINGPAY_DISBURSEMENT_ID=
SINGPAY_TIMEOUT=30
SINGPAY_ENABLE_TRANSFER=False
PAYMENT_SIMULATION_MODE=False
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
PAYMENT_WEBHOOK_SIGNATURE_REQUIRED=True

# Optional AI providers
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
